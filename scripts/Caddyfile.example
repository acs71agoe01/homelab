# Sanitized Caddyfile template — Internal HTTPS via Let's Encrypt DNS-01 wildcard
# Build with: xcaddy build --with github.com/caddy-dns/duckdns
# Set DuckDNS A-record to 127.0.0.1 and resolve *.{$DUCKDNS_DOMAIN} locally via AdGuard + Tailscale Split DNS.

*.{$DUCKDNS_DOMAIN} {
    tls {
        dns duckdns {$DUCKDNS_TOKEN}
        propagation_delay 15s
        propagation_timeout 5m
        resolvers 1.1.1.1 9.9.9.9
    }

    @ai host ai.{$DUCKDNS_DOMAIN}
    handle @ai {
        reverse_proxy 127.0.0.1:3000
    }

    @cloud host cloud.{$DUCKDNS_DOMAIN}
    handle @cloud {
        redir /.well-known/carddav /remote.php/dav 301
        redir /.well-known/caldav /remote.php/dav 301
        reverse_proxy 127.0.0.1:8082
    }

    @media host media.{$DUCKDNS_DOMAIN}
    handle @media {
        reverse_proxy 127.0.0.1:8096
    }

    @dns host dns.{$DUCKDNS_DOMAIN}
    handle @dns {
        reverse_proxy 127.0.0.1:8080
    }

    @status host status.{$DUCKDNS_DOMAIN}
    handle @status {
        reverse_proxy 127.0.0.1:3002
    }

    @metrics host metrics.{$DUCKDNS_DOMAIN}
    handle @metrics {
        reverse_proxy 127.0.0.1:8090
    }

    @portainer host portainer.{$DUCKDNS_DOMAIN}
    handle @portainer {
        @trusted remote_ip 192.168.1.20 192.168.1.30 100.64.0.0/10 127.0.0.1 ::1
        handle @trusted {
            reverse_proxy 127.0.0.1:9000
        }
        respond "Forbidden" 403
    }

    handle {
        abort
    }
}